# Supabase project configuration
# Use these names on the server and map the Vite-safe aliases in your deployment settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Vite client aliases used by the browser integration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Brevo transactional email for Bengali approval/suspension notices
# Create the key from Brevo → Settings → SMTP & API → API Keys (not SMTP Keys).
BREVO_API_KEY=your-brevo-api-key
# This address must be verified in Brevo under Senders & IP.
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=সমিতি-নাইন্টি ত্রি
